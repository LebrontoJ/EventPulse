<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.eventpulse</groupId>
    <artifactId>eventpulse</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>EventPulse</name>
    <description>Kafka-based request stream processing and validation system.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <prometheus.version>1.8.0</prometheus.version>
        <logback.version>1.5.6</logback.version>
        <logstash-logback-encoder.version>7.4</logstash-logback-encoder.version>
        <!-- Used only by the *IT.java integration tests (see maven-failsafe-plugin below) to start
             a real, ephemeral Kafka broker in Docker instead of the Mock*-based unit tests. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <exec.mainClass>com.eventpulse.app.EventPulseApplication</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>3.7.1</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <!--
            Structured JSON console logging in place of slf4j-simple: logback-classic is the slf4j
            binding, logstash-logback-encoder formats each line as JSON so logs are easy to ship to
            ELK/Loki/etc. Both are runtime-only - main code depends only on slf4j-api.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.prometheus</groupId>
            <artifactId>prometheus-metrics-core</artifactId>
            <version>${prometheus.version}</version>
        </dependency>
        <dependency>
            <groupId>io.prometheus</groupId>
            <artifactId>prometheus-metrics-instrumentation-jvm</artifactId>
            <version>${prometheus.version}</version>
        </dependency>
        <dependency>
            <groupId>io.prometheus</groupId>
            <artifactId>prometheus-metrics-exporter-httpserver</artifactId>
            <version>${prometheus.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            Testcontainers: starts a real Kafka broker in Docker for the *IT.java integration tests
            (src/test/java/com/eventpulse/integration). Test-scoped only, so it never reaches the
            shaded application jar. Requires a Docker daemon to actually run the containers; the IT
            tests themselves are annotated @Testcontainers(disabledWithoutDocker = true) so a
            machine without Docker gets those tests skipped rather than the build failing outright.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <!--
                Runs the *IT.java integration tests (Failsafe's default include pattern), separately
                from Surefire's *Test.java unit tests: standard Maven convention for keeping a fast
                unit-test-only `mvn test` distinct from the slower, Docker-dependent integration
                tests, which only run during `mvn verify`/`mvn integration-test`. The `integration-test`
                goal runs the tests; the `verify` goal (bound to the verify phase, same as jacoco-check
                below) is what actually fails the build on an integration test failure - the
                integration-test phase itself does not fail fast, so a subsequent post-integration-test
                cleanup step always gets a chance to run.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <configuration>
                    <!--
                        Application entry points (main() methods that connect to a real Kafka broker) are
                        excluded from the coverage count: they aren't realistically unit-testable and would
                        otherwise drag the ratio down regardless of how well the rest of the code is tested.
                    -->
                    <excludes>
                        <exclude>com/eventpulse/app/*Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                        Fails the build if overall line coverage drops below the threshold. Bound to verify,
                        so CI (which runs `mvn verify`) enforces it while a plain `mvn test` locally does not.
                        50% is a conservative starting floor - run `mvn verify` locally and check
                        target/site/jacoco/index.html for the actual number, then raise this over time.
                    -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
            <!--
                Produces a single runnable jar with all dependencies merged in (target/eventpulse-*.jar),
                used by the Dockerfile. Bound to the package phase. A plain `mvn test` never reaches it, but
                CI runs `mvn verify` (see .github/workflows/ci.yml), which passes through package first - so
                CI also confirms the shaded jar still builds.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>generator</id>
            <properties>
                <exec.mainClass>com.eventpulse.app.RequestGeneratorApplication</exec.mainClass>
            </properties>
        </profile>
    </profiles>
</project>
